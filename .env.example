# Environment
APP_ENV=development
APP_DEBUG=true
APP_NAME=JobPair.aloe
APP_VERSION=1.0.0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Database
# Copy this file to .env and replace every <set-in-env> placeholder
# with a real value. None of these should ever be committed.
POSTGRES_USER=jobpair
POSTGRES_PASSWORD=<set-in-env>
POSTGRES_DB=jobpair
DATABASE_URL=postgresql+asyncpg://jobpair:<set-in-env>@postgres:5432/jobpair
DATABASE_URL_SYNC=postgresql://jobpair:<set-in-env>@postgres:5432/jobpair

# Storage
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf

# ML
ML_MODEL_DIR=/app/ml_models
SKLEARN_MODEL_PATH=/app/ml_models/sklearn_baseline.joblib
PYTORCH_MODEL_PATH=/app/ml_models/pytorch_matcher.pt
TRAINING_DATA_PATH=/app/ml_models/training_data.json

# Logging
LOG_LEVEL=INFO
